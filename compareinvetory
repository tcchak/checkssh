#!/usr/bin/env bash
#==============================================================================
# compare-inventory.sh
# VERSION: 1.1.0
#------------------------------------------------------------------------------
# TARGET ENVIRONMENT
#   - Primary: RHEL 8.10 (bash 4.x)
#   - Also compatible with macOS bash 3.2
#
# USAGE
#   ./compare-inventory.sh [finalized-inventory] [inventory.ini]
#
# PROMPTS
#   1) Finalized inventory path  (default: finalized-inventory)
#   2) Inventory.ini path        (default: inventory.ini)
#   3) Confirm removal of extras (y/N) after differences are shown
#
# BEHAVIOR
#   Part 1 — Cross-check both files (what each is missing from the other):
#     A) In inventory.ini but NOT in finalized-inventory  (extras)
#     B) In finalized-inventory but NOT in inventory.ini  (missing from inventory)
#   Part 2 — Prompt to remove extras (A) from inventory.ini.
#     Shows each server that would be deleted and the total delete count.
#     A timestamped backup is written before any write.
#     (Hosts only in finalized-inventory are reported, not auto-added.)
#
# SECTIONS ARE NOT SERVERS
#   Lines in brackets such as [ocp151], [ocp151:vars], [ocp151:children]
#   are Ansible group/section headers only. They are never compared, counted,
#   or deleted as servers.
#
# FINALIZED-INVENTORY FORMAT
#   One hostname per line (preferred):
#     sampleservera
#     sampleserverb
#     sampleserverc
#   Ansible-style host lines are also accepted (hostname = first field).
#   Bracket section headers in this file are ignored.
#
# INVENTORY.INI FORMAT
#   Standard Ansible INI groups with ansible_host=, e.g.:
#     [ocp151]
#     sampleservera ansible_host=1.2.3.4
#   Only lines with ansible_host= count as servers.
#
# EXIT CODES
#   0  no extras, or extras removed successfully, or user declined removal
#   1  setup/validation error or failed write
#
# MAINTENANCE
#   Keep this comment block and inline comments in sync when behavior changes.
#   Bump VERSION on each change.
#==============================================================================

set -euo pipefail

FINALIZED_FILE="${1:-}"
INVENTORY_FILE="${2:-}"

#------------------------------------------------------------------------------
# UI colors — only when stdout is a terminal
#------------------------------------------------------------------------------
if [ -t 1 ]; then
  BOLD='\033[1m'
  DIM='\033[2m'
  GREEN='\033[0;32m'
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  BLUE='\033[0;34m'
  WHITE='\033[1;37m'
  NC='\033[0m'
else
  BOLD='' DIM='' GREEN='' RED='' YELLOW='' CYAN='' BLUE='' WHITE='' NC=''
fi

HR="──────────────────────────────────────────────────────────────"

usage() {
  cat <<'EOF'
Usage: ./compare-inventory.sh [finalized-inventory] [inventory.ini]

Cross-check finalized-inventory and inventory.ini:
  - servers in inventory.ini but not in finalized-inventory (extras)
  - hosts in finalized-inventory but not in inventory.ini (missing)
Optionally remove extras from inventory.ini.

Finalized file format (one hostname per line):
  sampleservera
  sampleserverb
  sampleserverc
EOF
}

expand_path() {
  local path="$1"
  case "$path" in
    "~/"*) path="${HOME}/${path#~/}" ;;
    "~") path="${HOME}" ;;
  esac
  printf '%s' "$path"
}

die() {
  echo -e "${RED}ERROR${NC}  $*" >&2
  exit 1
}

ask() {
  local label="$1"
  local default="${2:-}"
  if [ -n "$default" ]; then
    printf "      %b%s%b  %b%s%b " "$DIM" "$label" "$NC" "$CYAN" "[$default]" "$NC"
  else
    printf "      %b%s%b  " "$DIM" "$label" "$NC"
  fi
  read -r REPLY
  if [ -z "$REPLY" ] && [ -n "$default" ]; then
    REPLY="$default"
  fi
}

confirm_ok() {
  echo -e "      ${GREEN}✓${NC}  $*"
}

print_banner() {
  echo
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  echo -e "${BOLD}${WHITE}  Inventory Compare & Cleanup${NC}"
  echo -e "${DIM}  Find extras in inventory.ini vs finalized-inventory${NC}"
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  echo
}

#------------------------------------------------------------------------------
# is_section_line — true when line is an Ansible [bracket] section/group header
#------------------------------------------------------------------------------
# (logic inlined in awk below; documented here for maintenance)
#   Match: [ocp151]  [ocp151:vars]  [ocp151:children]  etc.
#   These are NEVER treated as server hostnames.

#------------------------------------------------------------------------------
# extract_finalized_hostnames — unique hostnames from finalized-inventory
#   - skips blanks, comments, and ANY [bracket] section line
#   - plain "hostname" or "host ansible_host=..." → field 1
#------------------------------------------------------------------------------
extract_finalized_hostnames() {
  local file="$1"
  awk '
    {
      line = $0
      sub(/\r$/, "", line)
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      if (line == "" || line ~ /^[#;]/) next
      # Bracket sections are groups, not servers
      if (line ~ /^\[/) next
      host = $1
      # Guard: never accept a token that still looks like [section]
      if (host == "" || host ~ /^\[/) next
      print host
    }
  ' "$file" | awk '!seen[$0]++'
}

#------------------------------------------------------------------------------
# extract_inventory_hostnames — unique server hostnames from inventory.ini
#   - ONLY lines containing ansible_host= are servers
#   - [section] / [group:vars] / [group:children] lines are ignored
#------------------------------------------------------------------------------
extract_inventory_hostnames() {
  local file="$1"
  awk '
    {
      line = $0
      sub(/\r$/, "", line)
      gsub(/^[ \t]+|[ \t]+$/, "", line)
      if (line == "" || line ~ /^[#;]/) next
      # Bracket sections are groups, not servers
      if (line ~ /^\[/) next
      # Inventory servers must declare ansible_host=
      if (line !~ /ansible_host=/) next
      host = $1
      if (host == "" || host ~ /^\[/) next
      print host
    }
  ' "$file" | awk '!seen[$0]++'
}

if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

print_banner

#------------------------------------------------------------------------------
# Setup prompts
#------------------------------------------------------------------------------
echo -e "  ${BOLD}${BLUE}1/2${NC}  ${BOLD}Finalized inventory${NC}"
if [ -z "$FINALIZED_FILE" ]; then
  ask "Path" "finalized-inventory"
  FINALIZED_FILE="$REPLY"
fi
FINALIZED_FILE="$(expand_path "$FINALIZED_FILE")"
[ -n "$FINALIZED_FILE" ] && [ -f "$FINALIZED_FILE" ] || die "finalized inventory not found: ${FINALIZED_FILE:-<empty>}"
confirm_ok "$FINALIZED_FILE"
echo

echo -e "  ${BOLD}${BLUE}2/2${NC}  ${BOLD}Inventory file${NC}"
if [ -z "$INVENTORY_FILE" ]; then
  ask "Path" "inventory.ini"
  INVENTORY_FILE="$REPLY"
fi
INVENTORY_FILE="$(expand_path "$INVENTORY_FILE")"
[ -n "$INVENTORY_FILE" ] && [ -f "$INVENTORY_FILE" ] || die "inventory file not found: ${INVENTORY_FILE:-<empty>}"
[ -w "$INVENTORY_FILE" ] || die "inventory file is not writable: $INVENTORY_FILE"
confirm_ok "$INVENTORY_FILE"
echo

#------------------------------------------------------------------------------
# Temp workspace
#------------------------------------------------------------------------------
TMPDIR_WORK="$(mktemp -d)"
trap 'rm -rf "$TMPDIR_WORK"' EXIT

FINAL_HOSTS="$TMPDIR_WORK/final_hosts.txt"
INV_HOSTS="$TMPDIR_WORK/inv_hosts.txt"
EXTRAS="$TMPDIR_WORK/extras.txt"          # in inventory.ini, not in finalized
MISSING="$TMPDIR_WORK/missing.txt"        # in finalized, not in inventory.ini
DELETE_LINES="$TMPDIR_WORK/delete_lines.txt"
NEW_INVENTORY="$TMPDIR_WORK/inventory.new"

extract_finalized_hostnames "$FINALIZED_FILE" > "$FINAL_HOSTS"
extract_inventory_hostnames "$INVENTORY_FILE" > "$INV_HOSTS"

final_count="$(wc -l < "$FINAL_HOSTS" | tr -d '[:space:]')"
inv_count="$(wc -l < "$INV_HOSTS" | tr -d '[:space:]')"
[ "$final_count" -gt 0 ] || die "no hostnames found in finalized inventory: $FINALIZED_FILE"
[ "$inv_count" -gt 0 ] || die "no server hostnames (ansible_host=) found in inventory: $INVENTORY_FILE"

# A) in inventory.ini but NOT in finalized-inventory
awk 'NR==FNR { keep[$1]=1; next } !keep[$1] { print }' "$FINAL_HOSTS" "$INV_HOSTS" > "$EXTRAS"
extra_host_count="$(wc -l < "$EXTRAS" | tr -d '[:space:]')"

# B) in finalized-inventory but NOT in inventory.ini
awk 'NR==FNR { have[$1]=1; next } !have[$1] { print }' "$INV_HOSTS" "$FINAL_HOSTS" > "$MISSING"
missing_host_count="$(wc -l < "$MISSING" | tr -d '[:space:]')"

#------------------------------------------------------------------------------
# Part 1 — cross-check: what each file is missing from the other
#------------------------------------------------------------------------------
echo -e "  ${BOLD}${CYAN}${HR}${NC}"
echo -e "  ${BOLD}Part 1 · Cross-check${NC}"
echo -e "  ${BOLD}${CYAN}${HR}${NC}"
printf "  %-28s %s\n" "Finalized hosts" "$final_count"
printf "  %-28s %s\n" "Inventory servers" "$inv_count"
printf "  %-28s %s\n" "Only in inventory.ini" "$extra_host_count"
printf "  %-28s %s\n" "Only in finalized-inventory" "$missing_host_count"
echo -e "  ${DIM}[section] lines like [ocp151] are groups only — not counted as servers${NC}"
echo

# --- A) available in inventory.ini, not in finalized-inventory ---
echo -e "  ${BOLD}${YELLOW}A) In inventory.ini · NOT in finalized-inventory${NC}"
echo -e "  ${DIM}   (extras — candidates to remove from inventory.ini)${NC}"
if [ "$extra_host_count" -eq 0 ]; then
  echo -e "      ${GREEN}none${NC}"
else
  while IFS= read -r host || [ -n "$host" ]; do
    [ -n "$host" ] || continue
    printf "      · %s\n" "$host"
  done < "$EXTRAS"
fi
echo

# --- B) available in finalized-inventory, not in inventory.ini ---
echo -e "  ${BOLD}${YELLOW}B) In finalized-inventory · NOT in inventory.ini${NC}"
echo -e "  ${DIM}   (missing from inventory.ini — not auto-added)${NC}"
if [ "$missing_host_count" -eq 0 ]; then
  echo -e "      ${GREEN}none${NC}"
else
  while IFS= read -r host || [ -n "$host" ]; do
    [ -n "$host" ] || continue
    printf "      · %s\n" "$host"
  done < "$MISSING"
fi
echo

if [ "$extra_host_count" -eq 0 ] && [ "$missing_host_count" -eq 0 ]; then
  echo -e "  ${GREEN}Files match.${NC} No hostname differences between the two lists."
  echo
  exit 0
fi

if [ "$extra_host_count" -eq 0 ]; then
  echo -e "  ${DIM}No extras in inventory.ini — skipping removal step.${NC}"
  echo
  exit 0
fi

# Build a detailed list of inventory SERVER LINES that will be deleted.
# Format: section<TAB>hostname<TAB>ip
# [bracket] section headers are tracked for display only — never deleted as servers.
awk -v extras_file="$EXTRAS" '
  BEGIN {
    while ((getline h < extras_file) > 0) {
      gsub(/^[ \t]+|[ \t]+$/, "", h)
      if (h != "") extra[h] = 1
    }
    close(extras_file)
    section = "ungrouped"
  }
  {
    line = $0
    sub(/\r$/, "", line)
    trim = line
    gsub(/^[ \t]+|[ \t]+$/, "", trim)
    if (trim == "" || trim ~ /^[#;]/) next
    # Bracket line = group/section header, not a server
    if (trim ~ /^\[/) {
      section = trim
      sub(/^\[/, "", section)
      sub(/\].*$/, "", section)
      next
    }
    # Only real inventory server rows
    if (trim !~ /ansible_host=/) next
    host = $1
    if (host == "" || host ~ /^\[/) next
    if (!(host in extra)) next
    ip = "-"
    for (i = 2; i <= NF; i++) {
      if ($i ~ /^ansible_host=/) {
        ip = substr($i, index($i, "=") + 1)
        break
      }
    }
    printf "%s\t%s\t%s\n", section, host, ip
  }
' "$INVENTORY_FILE" > "$DELETE_LINES"

delete_count="$(wc -l < "$DELETE_LINES" | tr -d '[:space:]')"

#------------------------------------------------------------------------------
# Part 2 — prompt for removal of extras from inventory.ini
#------------------------------------------------------------------------------
echo -e "  ${BOLD}${CYAN}${HR}${NC}"
echo -e "  ${BOLD}Part 2 · Removal preview (extras only)${NC}"
echo -e "  ${BOLD}${CYAN}${HR}${NC}"
echo -e "  Servers in inventory.ini that are ${BOLD}not${NC} in finalized-inventory"
echo -e "  can be deleted from ${BOLD}inventory.ini${NC}:"
echo
printf "  ${DIM}%-18s  %-22s  %s${NC}\n" "SECTION" "HOSTNAME" "IP"
printf "  ${DIM}%-18s  %-22s  %s${NC}\n" "-------" "--------" "--"

while IFS="$(printf '\t')" read -r section host ip || [ -n "${section:-}" ]; do
  [ -n "${section:-}" ] || continue
  printf "  %-18s  %-22s  %s\n" "$section" "$host" "$ip"
done < "$DELETE_LINES"

echo
echo -e "  ${BOLD}${RED}Total servers to delete from inventory.ini: ${delete_count}${NC}"
echo -e "  ${DIM}Unique extra hostnames: ${extra_host_count}${NC}"
if [ "$missing_host_count" -gt 0 ]; then
  echo -e "  ${DIM}Note: ${missing_host_count} host(s) only in finalized-inventory were not added.${NC}"
fi
echo

ask "Remove these extras from inventory.ini? (y/N)" "N"
ANSWER="$(printf '%s' "$REPLY" | tr '[:upper:]' '[:lower:]')"

if [ "$ANSWER" != "y" ] && [ "$ANSWER" != "yes" ]; then
  echo
  echo -e "  ${YELLOW}No changes made.${NC} inventory.ini left untouched."
  echo
  exit 0
fi

# Rewrite inventory.ini: drop SERVER lines whose hostname is in the extras set.
# [bracket] section headers are always kept (they are not servers); empty
# sections are removed in the next pass.
awk -v extras_file="$EXTRAS" '
  BEGIN {
    while ((getline h < extras_file) > 0) {
      gsub(/^[ \t]+|[ \t]+$/, "", h)
      if (h != "") extra[h] = 1
    }
    close(extras_file)
  }
  {
    line = $0
    sub(/\r$/, "", line)
    trim = line
    gsub(/^[ \t]+|[ \t]+$/, "", trim)

    # Always keep blank / comment lines for now (cleaned later)
    if (trim == "" || trim ~ /^[#;]/) {
      print line
      next
    }

    # Section / group headers — never treated as servers; always keep for now
    if (trim ~ /^\[/) {
      print line
      next
    }

    # Only ansible_host= rows are removable servers
    if (trim ~ /ansible_host=/) {
      host = $1
      if (host in extra) next   # delete this server line
    }
    print line
  }
' "$INVENTORY_FILE" > "$NEW_INVENTORY.raw"

# Remove section headers that have no host lines underneath (and tidy blanks).
awk '
  function flush_section(   j) {
    if (!have_section) return
    if (host_count > 0) {
      print section_line
      for (j = 1; j <= buf_n; j++) print buf[j]
      if (pending_blank) print ""
    }
    have_section = 0
    host_count = 0
    buf_n = 0
    pending_blank = 0
  }
  {
    line = $0
    sub(/\r$/, "", line)
    trim = line
    gsub(/^[ \t]+|[ \t]+$/, "", trim)

    if (trim ~ /^\[/) {
      flush_section()
      section_line = line
      have_section = 1
      host_count = 0
      buf_n = 0
      pending_blank = 0
      next
    }

    if (trim == "") {
      if (have_section) pending_blank = 1
      else if (printed_any) print ""
      next
    }

    if (trim ~ /^[#;]/) {
      if (have_section) {
        buf[++buf_n] = line
      } else {
        print line
        printed_any = 1
      }
      next
    }

    # Content inside a section — only ansible_host= rows count as servers
    if (have_section) {
      buf[++buf_n] = line
      if (trim ~ /ansible_host=/) host_count++
      pending_blank = 0
    } else {
      print line
      printed_any = 1
    }
  }
  END { flush_section() }
' "$NEW_INVENTORY.raw" > "$NEW_INVENTORY"

# Backup then replace
BACKUP="${INVENTORY_FILE}.bak.$(date +%Y%m%d%H%M%S)"
cp "$INVENTORY_FILE" "$BACKUP"
cp "$NEW_INVENTORY" "$INVENTORY_FILE"

echo
echo -e "  ${GREEN}Removed ${delete_count} server line(s) from inventory.ini${NC}"
echo -e "  ${DIM}Backup saved to ${BACKUP}${NC}"
echo
exit 0
