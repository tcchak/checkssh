#!/usr/bin/env bash
#==============================================================================
# test-ssh-inventory.sh
# VERSION: 1.2.0
#------------------------------------------------------------------------------
# TARGET ENVIRONMENT
#   - Primary: RHEL 8.10 (bash 4.x, OpenSSH)
#   - Also compatible with macOS bash 3.2
#
# USAGE
#   ./test-ssh-inventory.sh [inventory_file] [masterfile]
#
# PROMPTS (before any SSH tests run)
#   1) Inventory file path   (skipped if passed as $1; default: inventory.ini)
#   2) Master file path      (skipped if passed as $2; default: masterfile.txt)
#   3) SSH port number       (default: 64022)
#   4) Private key path      (default: $SSH_PRIVATE_KEY or ~/.ssh/id_rsa)
#   5) Landing user          (default: redhat-chaos; or $SSH_USER)
#
# ROOT SWITCH CHECK (required for PASS)
#   After SSH login, tests passwordless sudo to root via:
#     1) sudo -n -i -- true
#     2) fallback: sudo -n su -c true
#   PASS requires SSH auth AND a successful root switch.
#
# MULTI-SECTION BEHAVIOR
#   All [section] groups are parsed up front into a temp host list, then every
#   host is tested by index (1..N). This avoids SSH consuming loop stdin and
#   stopping early after a few hosts.
#
# MASTERFILE FORMAT (AppCode map only — not inventory)
#   Hostname IpAddress AppCode
#   sampleservera 1.2.3.4 AMVA
#   sampleserverb 2.3.4.5 MAST
#   sampleserverc 1.2.3.7 MUST
#   Lookup order per tested host:
#     1) hostname + IP  2) IP only  3) hostname only
#   Unmapped hosts show AppCode as "-".
#
# INVENTORY FORMAT (example) — separate from masterfile
#   [ocp151]
#   sampleservera ansible_host=1.2.3.4
#   sampleserverb ansible_host=2.3.4.5
#
#   [ocp153]
#   sampleserverc ansible_host=1.2.3.7
#
# ENVIRONMENT OVERRIDES
#   SSH_CONNECT_TIMEOUT  Connect timeout in seconds (default: 5)
#   SSH_USER             Default landing user (still prompted)
#   SSH_PRIVATE_KEY      Default private key path (still prompted)
#   MASTER_FILE          Default masterfile path (still prompted)
#
# EXIT CODES
#   0  all hosts passed (SSH auth + sudo root switch)
#   1  one or more hosts failed (or setup/validation error)
#
# MAINTENANCE
#   Keep this comment block and the inline comments in sync whenever behavior,
#   prompts, parsing, or UI output changes. Bump VERSION on each change.
#==============================================================================

# Fail on unset vars; fail on pipeline errors. Errexit is temporarily disabled
# during the SSH test loop so one failed host cannot abort remaining hosts.
set -euo pipefail

# Optional paths from CLI; empty means we will prompt.
INVENTORY_FILE="${1:-}"
MASTER_FILE="${2:-${MASTER_FILE:-}}"

# SSH connect timeout (seconds). Overridable via environment.
TIMEOUT="${SSH_CONNECT_TIMEOUT:-5}"

#------------------------------------------------------------------------------
# UI colors — enabled only when stdout is a real terminal (not a pipe/file).
#------------------------------------------------------------------------------
if [ -t 1 ]; then
  BOLD='\033[1m'
  DIM='\033[2m'
  GREEN='\033[0;32m'
  RED='\033[0;31m'
  YELLOW='\033[0;33m'
  CYAN='\033[0;36m'
  BLUE='\033[0;34m'
  WHITE='\033[1;37m'
  NC='\033[0m'          # reset / "no color"
else
  BOLD='' DIM='' GREEN='' RED='' YELLOW='' CYAN='' BLUE='' WHITE='' NC=''
fi

# Horizontal rules used by banner / config / summary panels.
HR="──────────────────────────────────────────────────────────────"
HR_THIN="──────────────────────────────────────────────────────────────"

#------------------------------------------------------------------------------
# usage — print help text for -h / --help
#------------------------------------------------------------------------------
usage() {
  cat <<'EOF'
Usage: ./test-ssh-inventory.sh [inventory_file] [masterfile]

Reads hosts with ansible_host=<ip> from an Ansible inventory file,
maps each host to an AppCode from masterfile.txt, prompts for SSH port,
private key, and landing user, then tests SSH and sudo-to-root across
all sections.

PASS requires authenticated SSH and passwordless sudo root switch
(sudo -i, with sudo su fallback).

Masterfile table format:
  Hostname IpAddress AppCode
  sampleserverc 1.2.3.7 MUST

Environment:
  SSH_CONNECT_TIMEOUT  Connect timeout in seconds (default: 5)
  SSH_USER             Default landing user (also prompted)
  SSH_PRIVATE_KEY      Default private key path (also prompted)
  MASTER_FILE          Default masterfile path (also prompted)
EOF
}

#------------------------------------------------------------------------------
# expand_path — turn leading ~/ into $HOME (e.g. ~/.ssh/id_rsa)
#------------------------------------------------------------------------------
expand_path() {
  local path="$1"
  case "$path" in
    "~/"*) path="${HOME}/${path#~/}" ;;
    "~") path="${HOME}" ;;
  esac
  printf '%s' "$path"
}

#------------------------------------------------------------------------------
# die — print an error and exit 1
#------------------------------------------------------------------------------
die() {
  echo -e "${RED}ERROR${NC}  $*" >&2
  exit 1
}

#------------------------------------------------------------------------------
# print_banner — top-of-run title panel
#------------------------------------------------------------------------------
print_banner() {
  echo
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  echo -e "${BOLD}${WHITE}  SSH Inventory Connectivity Check${NC}"
  echo -e "${DIM}  SSH auth + sudo-to-root check across all inventory sections${NC}"
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  echo
}

#------------------------------------------------------------------------------
# print_step — numbered setup step header, e.g. [1/5] Inventory file
#------------------------------------------------------------------------------
print_step() {
  local num="$1"
  local title="$2"
  echo -e "${BOLD}${BLUE}[$num/5]${NC} ${BOLD}${title}${NC}"
}

#------------------------------------------------------------------------------
# ask — prompt the user; sets global REPLY
#   ask "Label"            -> required input (no default)
#   ask "Label" "default"  -> Enter keeps default
#------------------------------------------------------------------------------
ask() {
  local label="$1"
  local default="${2:-}"
  if [ -n "$default" ]; then
    printf "      %b%s%b %b[%s]%b: " "$DIM" "$label" "$NC" "$CYAN" "$default" "$NC"
  else
    printf "      %b%s%b: " "$DIM" "$label" "$NC"
  fi
  read -r REPLY
  if [ -z "$REPLY" ] && [ -n "$default" ]; then
    REPLY="$default"
  fi
}

#------------------------------------------------------------------------------
# lookup_app_code — resolve AppCode for a host
#   Order: hostname+IP (MASTER_BY_HOSTIP), then IP (MASTER_BY_IP),
#   then hostname (MASTER_BY_HOST). Prints AppCode or "-" when unmapped.
#------------------------------------------------------------------------------
lookup_app_code() {
  local host_name="$1"
  local ip="$2"
  local code=""

  code="$(awk -F '\t' -v h="$host_name" -v ip="$ip" \
    '$1 == h && $2 == ip { print $3; exit }' "$MASTER_BY_HOSTIP")"
  if [ -z "$code" ]; then
    code="$(awk -F '\t' -v k="$ip" '$1 == k { print $2; exit }' "$MASTER_BY_IP")"
  fi
  if [ -z "$code" ]; then
    code="$(awk -F '\t' -v k="$host_name" '$1 == k { print $2; exit }' "$MASTER_BY_HOST")"
  fi
  if [ -z "$code" ]; then
    code="-"
  fi
  printf '%s' "$code"
}

#------------------------------------------------------------------------------
# print_config — show resolved settings + discovered sections/host counts
#------------------------------------------------------------------------------
print_config() {
  echo
  echo -e "${BOLD}${CYAN}${HR_THIN}${NC}"
  echo -e "${BOLD}  Configuration${NC}"
  echo -e "${BOLD}${CYAN}${HR_THIN}${NC}"
  printf "  %-14s %s\n" "Inventory" "$INVENTORY_FILE"
  printf "  %-14s %s\n" "Masterfile" "$MASTER_FILE"
  printf "  %-14s %s\n" "AppCodes" "$master_count mapping(s)"
  printf "  %-14s %s\n" "Port" "$SSH_PORT"
  printf "  %-14s %s\n" "Private key" "$PRIVATE_KEY"
  printf "  %-14s %s\n" "Landing user" "$SSH_USER"
  printf "  %-14s %ss\n" "Timeout" "$TIMEOUT"
  printf "  %-14s %s\n" "Sections" "$section_count"
  printf "  %-14s %s host(s)\n" "Targets" "$total"
  echo -e "${BOLD}${CYAN}${HR_THIN}${NC}"

  # List each section and how many hosts it contributed (inventory order).
  if [ -s "$HOST_LIST" ]; then
    echo -e "  ${DIM}Sections to test:${NC}"
    awk -F '\t' '
      { count[$1]++; if (!seen[$1]++) order[++n] = $1 }
      END {
        for (i = 1; i <= n; i++) {
          s = order[i]
          printf "    - %-20s (%s host(s))\n", s, count[s]
        }
      }
    ' "$HOST_LIST"
  fi

  echo -e "${BOLD}${CYAN}${HR_THIN}${NC}"
  echo
}

#------------------------------------------------------------------------------
# print_table_header — column headers for per-section result rows
#------------------------------------------------------------------------------
print_table_header() {
  printf "  ${DIM}%-6s  %-8s  %-22s  %-15s  %s${NC}\n" \
    "STATUS" "APPCODE" "HOST" "IP" "DETAIL"
  printf "  ${DIM}%-6s  %-8s  %-22s  %-15s  %s${NC}\n" \
    "------" "-------" "----" "--" "------"
}

#------------------------------------------------------------------------------
# print_summary — final pass/fail totals and overall label
#------------------------------------------------------------------------------
print_summary() {
  local overall_color overall_label
  if [ "$fail" -eq 0 ]; then
    overall_color="$GREEN"
    overall_label="ALL PASSED"
  else
    overall_color="$RED"
    overall_label="FAILURES DETECTED"
  fi

  echo
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  echo -e "${BOLD}  Summary${NC}"
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  printf "  %-12s %b%s%b\n" "Passed" "${GREEN}" "$pass" "${NC}"
  printf "  %-12s %b%s%b\n" "Failed" "${RED}" "$fail" "${NC}"
  printf "  %-12s %s\n" "Total" "$total"
  echo
  echo -e "  Overall: ${BOLD}${overall_color}${overall_label}${NC}"
  echo -e "${BOLD}${CYAN}${HR}${NC}"
  echo
}

#==============================================================================
# MAIN
#==============================================================================

# Help and exit early (no prompts / no tests).
if [ "${1:-}" = "-h" ] || [ "${1:-}" = "--help" ]; then
  usage
  exit 0
fi

print_banner

#------------------------------------------------------------------------------
# Setup prompts (must complete before any SSH work)
#------------------------------------------------------------------------------

# [1/5] Inventory file
print_step 1 "Inventory file"
if [ -z "$INVENTORY_FILE" ]; then
  ask "Path to inventory file" "inventory.ini"
  INVENTORY_FILE="$REPLY"
fi
INVENTORY_FILE="$(expand_path "$INVENTORY_FILE")"
[ -n "$INVENTORY_FILE" ] && [ -f "$INVENTORY_FILE" ] || die "inventory file not found: ${INVENTORY_FILE:-<empty>}"
echo -e "      ${GREEN}OK${NC}  $INVENTORY_FILE"
echo

# [2/5] Masterfile (Hostname IpAddress AppCode)
print_step 2 "Masterfile (AppCode map)"
if [ -z "$MASTER_FILE" ]; then
  ask "Path to masterfile" "masterfile.txt"
  MASTER_FILE="$REPLY"
fi
MASTER_FILE="$(expand_path "$MASTER_FILE")"
[ -n "$MASTER_FILE" ] && [ -f "$MASTER_FILE" ] || die "masterfile not found: ${MASTER_FILE:-<empty>}"
echo -e "      ${GREEN}OK${NC}  $MASTER_FILE"
echo

# [3/5] SSH port
print_step 3 "SSH port"
ask "Port number" "64022"
SSH_PORT="$REPLY"
case "$SSH_PORT" in
  ''|*[!0-9]*) die "invalid port: $SSH_PORT" ;;
esac
[ "$SSH_PORT" -ge 1 ] && [ "$SSH_PORT" -le 65535 ] || die "invalid port: $SSH_PORT"
echo -e "      ${GREEN}OK${NC}  port $SSH_PORT"
echo

# [4/5] Private key used for publickey auth
print_step 4 "Private key"
ask "Key path" "${SSH_PRIVATE_KEY:-${HOME}/.ssh/id_rsa}"
PRIVATE_KEY="$(expand_path "$REPLY")"
[ -n "$PRIVATE_KEY" ] && [ -f "$PRIVATE_KEY" ] || die "private key not found: ${PRIVATE_KEY:-<empty>}"
[ -r "$PRIVATE_KEY" ] || die "private key is not readable: $PRIVATE_KEY"
echo -e "      ${GREEN}OK${NC}  $PRIVATE_KEY"
echo

# [5/5] Landing user (login account on the remote servers)
print_step 5 "Landing user"
ask "Login account" "${SSH_USER:-redhat-chaos}"
SSH_USER="$REPLY"
[ -n "$SSH_USER" ] || die "landing user is required"
echo -e "      ${GREEN}OK${NC}  $SSH_USER"
echo

#------------------------------------------------------------------------------
# Temp files — host list + AppCode lookup tables; removed on any exit.
#------------------------------------------------------------------------------
pass=0
fail=0
total=0
section_count=0
sections_found=""
master_count=0
last_printed_section=""

HOST_LIST="$(mktemp)"
MASTER_BY_IP="$(mktemp)"
MASTER_BY_HOST="$(mktemp)"
MASTER_BY_HOSTIP="$(mktemp)"
trap 'rm -f "$HOST_LIST" "$MASTER_BY_IP" "$MASTER_BY_HOST" "$MASTER_BY_HOSTIP"' EXIT

#------------------------------------------------------------------------------
# Parse masterfile — build AppCode lookups
# Accepts table rows: Hostname IpAddress AppCode
# Skips header row, blank/comment lines, [section] headers, ansible_host= lines
#------------------------------------------------------------------------------
awk '
  {
    line = $0
    sub(/\r$/, "", line)
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line == "" || line ~ /^[#;]/) next
    if (line ~ /^\[[^]]+\]$/) next
    if (line ~ /ansible_host=/) next

    n = split(line, f, /[ \t]+/)
    if (n < 3) next

    host = f[1]
    ip = f[2]
    app = f[3]

    # Skip header row (Hostname IpAddress AppCode)
    if (tolower(host) == "hostname" && tolower(app) == "appcode") next

    # host+ip (preferred), ip-only, host-only
    printf "%s\t%s\t%s\n", host, ip, app >> HOSTIP_FILE
    printf "%s\t%s\n", ip, app >> IP_FILE
    printf "%s\t%s\n", host, app >> HOST_FILE
  }
' HOSTIP_FILE="$MASTER_BY_HOSTIP" IP_FILE="$MASTER_BY_IP" HOST_FILE="$MASTER_BY_HOST" \
  "$MASTER_FILE"

master_count="$(wc -l < "$MASTER_BY_HOSTIP" | tr -d '[:space:]')"
[ "$master_count" -gt 0 ] || die "no AppCode rows found in masterfile: $MASTER_FILE"

#------------------------------------------------------------------------------
# Parse inventory — collect ALL sections / hosts before testing
# Host list line format:  section<TAB>hostname<TAB>ip
#------------------------------------------------------------------------------

# awk parser notes:
#   - strips Windows CR (\r)
#   - treats [group] lines as section changes (keeps scanning later sections)
#   - skips blanks / comments
#   - requires ansible_host=<ip> on the host line
#   - extra Ansible vars on the same line are ignored
awk '
  BEGIN { section = "ungrouped" }
  {
    line = $0
    sub(/\r$/, "", line)
    gsub(/^[ \t]+|[ \t]+$/, "", line)
    if (line == "" || line ~ /^[#;]/) next
    if (line ~ /^\[[^]]+\]$/) {
      section = line
      sub(/^\[/, "", section)
      sub(/\]$/, "", section)
      next
    }
    if (line !~ /ansible_host=/) next
    host = $1
    ip = ""
    for (i = 2; i <= NF; i++) {
      if ($i ~ /^ansible_host=/) {
        ip = substr($i, index($i, "=") + 1)
        break
      }
    }
    if (host != "" && ip != "") {
      printf "%s\t%s\t%s\n", section, host, ip
    }
  }
' "$INVENTORY_FILE" > "$HOST_LIST"

# Count hosts (trim whitespace from wc output for portability).
total="$(wc -l < "$HOST_LIST" | tr -d '[:space:]')"
[ "$total" -gt 0 ] || die "no hosts with ansible_host= found in $INVENTORY_FILE"

# Unique section list + count (inventory order preserved).
sections_found="$(awk -F '\t' '!seen[$1]++ { printf "%s%s", (n++ ? "|" : ""), $1 } END { print "" }' "$HOST_LIST")"
section_count="$(awk -F '\t' '!seen[$1]++ { c++ } END { print c+0 }' "$HOST_LIST")"

print_config

echo -e "${BOLD}  Running tests across ${section_count} section(s), ${total} host(s)...${NC}"
echo -e "${DIM}  Results include AppCode from masterfile (host+IP, then IP, then host).${NC}"
echo -e "${DIM}  PASS requires SSH auth + passwordless sudo to root (sudo -i, else sudo su).${NC}"
echo

#------------------------------------------------------------------------------
# Run SSH + sudo-to-root tests (index-based loop)
#------------------------------------------------------------------------------
set +e

# Remote check: SSH session must authenticate, then switch to root without a
# password prompt (-n). Try sudo -i first, then sudo su.
REMOTE_ROOT_CHECK='if sudo -n -i -- true >/dev/null 2>&1; then echo SUDO_OK sudo_-i; elif sudo -n su -c true >/dev/null 2>&1; then echo SUDO_OK sudo_su; else echo SUDO_FAIL; exit 1; fi'

i=1
while [ "$i" -le "$total" ]; do
  # Load host record i from the pre-parsed list.
  line="$(sed -n "${i}p" "$HOST_LIST")"
  section="$(printf '%s\n' "$line" | cut -f1)"
  host_name="$(printf '%s\n' "$line" | cut -f2)"
  ip="$(printf '%s\n' "$line" | cut -f3)"

  # Skip malformed rows (should not happen with the awk parser above).
  if [ -z "$section" ] || [ -z "$host_name" ] || [ -z "$ip" ]; then
    i=$((i + 1))
    continue
  fi

  # Map inventory host -> AppCode (IP first, then hostname).
  app_code="$(lookup_app_code "$host_name" "$ip")"

  # Print a new section header when the section changes.
  if [ "$section" != "$last_printed_section" ]; then
    echo
    echo -e "  ${BOLD}${CYAN}Section: ${section}${NC}"
    print_table_header
    last_printed_section="$section"
  fi

  # SSH options explained:
  #   -n / </dev/null     do not read stdin (protects callers / tooling)
  #   -i                  use the prompted private key only
  #   BatchMode=yes       never prompt for passwords/passphrases
  #   IdentitiesOnly=yes  do not try other keys from the agent
  #   PreferredAuthentications=publickey / PasswordAuthentication=no
  #                       force key-based auth for this check
  #   ConnectTimeout / ConnectionAttempts
  #                       bound how long a dead host can block the run
  #   StrictHostKeyChecking=accept-new
  #                       accept new host keys; still detect changes
  #   UserKnownHostsFile=/dev/null
  #                       avoid polluting the real known_hosts file
  #
  # PASS: SSH authenticates AND remote sudo root switch succeeds.
  ssh_output="$(
    ssh -n -i "$PRIVATE_KEY" \
      -p "$SSH_PORT" \
      -o BatchMode=yes \
      -o IdentitiesOnly=yes \
      -o PreferredAuthentications=publickey \
      -o PasswordAuthentication=no \
      -o ConnectTimeout="$TIMEOUT" \
      -o ConnectionAttempts=1 \
      -o StrictHostKeyChecking=accept-new \
      -o UserKnownHostsFile=/dev/null \
      -o LogLevel=ERROR \
      "${SSH_USER}@${ip}" \
      "$REMOTE_ROOT_CHECK" < /dev/null 2>&1
  )"
  ssh_rc=$?

  if [ "$ssh_rc" -eq 0 ] && printf '%s' "$ssh_output" | grep -q 'SUDO_OK'; then
    # SSH auth + sudo root switch both succeeded.
    sudo_method="$(printf '%s' "$ssh_output" | sed -n 's/.*SUDO_OK //p' | tr -d '\r' | awk 'NF{print $1; exit}')"
    status="PASS"
    detail="ssh+sudo ok (${sudo_method:-sudo})"
    pass=$((pass + 1))
    color="$GREEN"
  else
    # Distinguish SSH failure vs sudo-to-root failure for the detail column.
    status="FAIL"
    if printf '%s' "$ssh_output" | grep -qiE 'Permission denied|Authentication failed|publickey'; then
      detail="authentication failed"
    elif printf '%s' "$ssh_output" | grep -q 'SUDO_FAIL' \
      || printf '%s' "$ssh_output" | grep -qiE 'sudo:[[:space:]]|a password is required|is not in the sudoers'; then
      detail="sudo to root failed"
    else
      # Collapse multi-line ssh errors into one short detail field.
      detail="$(printf '%s' "${ssh_output:-connection failed (rc=$ssh_rc)}" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g' | cut -c1-80)"
    fi
    fail=$((fail + 1))
    color="$RED"
  fi

  # Result row: STATUS APPCODE HOST IP [n/total] DETAIL
  printf "  %b%-6s%b  %-8s  %-22s  %-15s  [%s/%s] %s\n" \
    "$color" "$status" "$NC" "$app_code" "$host_name" "$ip" "$i" "$total" "$detail"

  i=$((i + 1))
done

# Restore errexit after the test phase.
set -e

print_summary

# Non-zero exit if any host failed SSH auth or sudo root switch.
if [ "$fail" -gt 0 ]; then
  exit 1
fi
exit 0
